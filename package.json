{
  "name": "dsh-profile-panel",
  "description": "DeepSeek Harness plugin status panel / profile ops console: current profile, bundle state, pending-restart detection (SSE), one-click restart, multi-profile sync install with dual-end (web+desktop) mode, supply-chain version preview, rollback/undo, update detection & align, health checks, profile diff, boot report, audit log, and agent tools. · DSH 插件状态面板 / profile 运维控制台：观察、诊断、变更管理与 Agent 化。",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lingxin-maz/dsh-profilespanel.git"
  },
  "bugs": {
    "url": "https://github.com/lingxin-maz/dsh-profilespanel/issues"
  },
  "homepage": "https://github.com/lingxin-maz/dsh-profilespanel",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "profile",
    "plugin-manager",
    "restart"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.json && pnpm run build:client",
    "build:client": "tsdown && node scripts/normalize-client-banner.mjs",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.web.config.ts",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client",
    "cordis.patch.yml",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
