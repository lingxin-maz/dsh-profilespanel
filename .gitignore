# dependencies
node_modules/
.pnpm-store/

# build artifacts kept OUT of version control by default — this repo commits
# lib/ + client/ so a github: install runs without a consumer-side build
# (regenerate with `pnpm build`); dist/ / coverage stays ignored.
dist/
coverage/
*.tsbuildinfo

# panel undo / audit stores if ever created in the repo root
.dsh-profile-panel/

# e2e verification fixture home (documented in VERIFICATION.md)
.e2e/

# test temp dirs
tests/tmp/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# temp / backup
*.tmp
*.swp
*.bak
*.orig
*.rej

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.iml
